<Project>
  <PropertyGroup>
    <Version>0.2.0</Version>
    <Authors>Emanuele Merlo</Authors>
    <Product>RaftCore</Product>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Genera/aggiorna i packages.lock.json a ogni restore: fissa anche le dipendenze transitive.
         Una volta committati i lockfile, abilitare il restore bloccato (docs/security-hardening.md). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
