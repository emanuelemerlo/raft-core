# Copiare in un file .env (nella cartella da cui si lancia `docker compose`) e valorizzare.
# Il compose rifiuta l'avvio se queste variabili mancano: nessun valore di default.
# Solo per sviluppo/prove di failover locali.

# Segreto del cluster, >= 16 caratteri casuali. Es.: openssl rand -base64 24
CLUSTER_SECRET=

# Password dell'utente sa di SQL Server (container di sviluppo). Deve rispettare la policy di SQL Server.
SA_PASSWORD=

# Opzionale: dopo il primo avvio di ciascun nodo, impostare a false.
# RAFT_FIRST_START=false
