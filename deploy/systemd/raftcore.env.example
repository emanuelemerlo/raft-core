# /etc/raftcore/raftcore.env  (permessi 0600, proprietario root)
CLUSTER_SECRET=sostituire-con-un-segreto-lungo-e-casuale
# Connessione cifrata (Encrypt=True) e certificato del server VALIDATO (TrustServerCertificate=False):
# richiede che SQL Server presenti un certificato emesso da una CA fidata dai nodi.
# NON usare TrustServerCertificate=True in produzione: disattiva la verifica del certificato e riapre il MITM.
RAFT_SQL_CONNECTION=Server=sql01;Database=Ingest;User Id=raftcore;Password=...;Encrypt=True;TrustServerCertificate=False
RaftCluster__NodeId=11111111-1111-1111-1111-111111111111
RaftCluster__Storage__DataDir=/var/lib/raftcore/data
# Solo al PRIMO avvio di un nuovo nodo, poi rimuovere:
# RaftCluster__Storage__AllowEmptyState=true
