<?xml version="1.0" encoding="utf-8"?>
<!--
  Sorgente dei pacchetti fissata alla sola nuget.org.
  <clear/> rimuove eventuali sorgenti ereditate da config di macchina/utente; il package source mapping
  vincola *ogni* pacchetto (incluse le dipendenze transitive) a nuget.org, chiudendo il rischio di
  dependency confusion da feed non previsti.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
