<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>RaftCore.Simulator</AssemblyName>
    <RootNamespace>RaftCore.Simulator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- P/Invoke per individuare, sospendere e terminare i processi dei nodi -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo Windows: riga di comando dei processi dei nodi (per riavviarli). Sugli altri sistemi si usa /proc o ps. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

</Project>
