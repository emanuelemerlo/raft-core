{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Urls": "http://localhost:5100",
  "Simulator": {
    // Dove cercare i nodi: ogni host viene sondato su tutte le porte (stesso formato di RaftCluster:RestPorts)
    "Hosts": [ "127.0.0.1" ],
    "Ports": "5001-5010",
    "StatusPollMs": 1000,
    "StatusTimeoutMs": 500,

    // Invio ciclico: valori iniziali, modificabili dall'interfaccia
    "DefaultIntervalMs": 200,
    "DefaultTarget": "RoundRobin",
    "MaxInFlight": 64,

    // Contratto client (REQ-CLI-1/2): timeout per tentativo >= RequestDeadlineMs + 5 s, retry con lo stesso ID e gli stessi byte
    "RequestTimeoutMs": 15000,
    "RetryBudgetMs": 60000,
    "MaxBodyBytes": 1048576,
    "Source": "simulatore",

    // State machine SharedFile del cluster di sviluppo (percorsi relativi alla cartella del progetto del simulatore)
    "AppliedLogPath": "../RaftCore/devcluster/shared-state/applied.log",
    // Directory di lavoro per riavviare un nodo terminato (Windows; su Linux/macOS si legge quella del processo)
    "NodeWorkingDirectory": "../RaftCore",
    // Variabili d'ambiente ereditate dai nodi riavviati dal simulatore (solo se non già impostate)
    "NodeEnvironment": {}
  }
}
