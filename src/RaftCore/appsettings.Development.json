{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "RaftCore": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "RaftCluster": {
    "ClusterId": "dev-cluster",
    "ClusterSize": 3,
    "MembershipMode": "Static",
    "NodeId": "11111111-1111-1111-1111-111111111111",
    "Members": [
      "11111111-1111-1111-1111-111111111111",
      "22222222-2222-2222-2222-222222222222",
      "33333333-3333-3333-3333-333333333333"
    ],
    "RestPorts": "5001-5010",
    "AdvertiseUrl": "http://127.0.0.1:{port}",
    "UdpMode": "Disabled",
    "Discovery": {
      "SeedHosts": [ "127.0.0.1" ],
      "ProbeIntervalMs": 1000
    },
    "DevCluster": {
      "Instances": 3,
      "ChildOutput": "Auto"
    },
    "Storage": {
      "DataDir": "./devcluster/data/{nodeId}",
      "AllowEmptyState": true,
      "MinFreeBytes": 104857600
    },
    "StateMachine": {
      "Provider": "SharedFile",
      "SharedFile": { "Directory": "./devcluster/shared-state" }
    }
  }
}
