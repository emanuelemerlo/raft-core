{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "RaftCore": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "RaftCluster": {
    "ClusterId": "cluster-prod-1",
    "ClusterSize": 3,
    "MembershipMode": "Static",
    "NodeId": "11111111-1111-1111-1111-111111111111",
    "Members": [
      "11111111-1111-1111-1111-111111111111",
      "22222222-2222-2222-2222-222222222222",
      "33333333-3333-3333-3333-333333333333"
    ],
    "RestPort": 5000,
    "RestPorts": "",
    "UdpMode": "Broadcast",
    "UdpDiscoveryPort": 8888,
    "AnnounceIntervalMs": 1000,
    "AnnounceTimeoutMs": 4000,
    "DiscoveryPhaseMs": 2000,
    "HeartbeatIntervalMs": 250,
    "ElectionTimeoutMinMs": 1000,
    "ElectionTimeoutMaxMs": 1800,
    "LeaderLeaseMs": 750,
    "ReplicationTimeoutMs": 1500,
    "FailoverWaitMs": 8000,
    "RequestDeadlineMs": 10000,
    "MaxBodyBytes": 1048576,
    "MaxForwardHops": 1,
    "RpcClockToleranceMs": 60000,
    "ShutdownGraceMs": 5000,
    "MaxConcurrentRequests": 256,
    "Peers": {},
    "Discovery": {
      "SeedHosts": [],
      "ProbePorts": "",
      "ProbeEnabled": true,
      "ProbeIntervalMs": 2000,
      "ProbeIdleIntervalMs": 30000,
      "ProbeTimeoutMs": 500,
      "UnreachableAfterFailures": 3
    },
    "Storage": {
      "DataDir": "./data/{nodeId}",
      "FsyncOnCommit": true,
      "MinFreeBytes": 1073741824,
      "AllowEmptyState": false
    },
    "Log": {
      "SegmentBytes": 67108864,
      "RetainEntries": 10000,
      "CompactionBatch": 5000,
      "CompactionIntervalMs": 5000
    },
    "StateMachine": {
      "Provider": "SharedFile",
      "MaxPendingAgeMinutes": 1440,
      "MaxApplyAttempts": 10,
      "ApplyRetryMaxDelayMs": 5000,
      "SharedFile": { "Directory": "./shared-state" },
      "SqlServer": {
        "ConnectionString": "",
        "Schema": "raft",
        "DataTable": "raft.IngestedData",
        "CommandTimeoutSeconds": 30,
        "AutoCreateSchema": true
      }
    }
  }
}
